{
  "name": "statechart-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && node --experimental-strip-types --test tools/test/*.test.ts && node --experimental-strip-types tools/src/check.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
