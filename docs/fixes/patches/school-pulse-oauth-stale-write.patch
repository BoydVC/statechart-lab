+const tokenGeneration = new Map<string, number>();
+
+/** Stamp a generation for this token path when a sign-in starts. */
+export function beginTokenFlow(path: string): number {
+  const next = (tokenGeneration.get(path) ?? 0) + 1;
+  tokenGeneration.set(path, next);
+  return next;
+}
+
+/** Write only if no newer sign-in started on this path since `generation`. */
+export function writeTokenIfCurrent(path: string, token: StoredToken, generation: number): boolean {
+  if (tokenGeneration.get(path) !== generation) return false;
+  writeToken(path, token);
+  return true;
+}
