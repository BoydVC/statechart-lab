---
title: "Live pulse after a disconnect"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Broken
    lg1: Behind
    lg2: Current
    lg3: Breaks LiveMeansCaughtUp
    lg4: Path to the LiveMeansCaughtUp bug
  }
  class lg0 pink
  class lg1 orange
  class lg2 teal
  class lg3 breaks
  class lg4 bugPath
  s0: Connected
  s1: Disconnected
  s2: Disconnected while a pulse was published
  s3: Pill says live, and a pulse was missed
  [*] --> s0
  s0 --> s1: the stream errors
  s1 --> s0: the stream reconnects
  s1 --> s2: a pulse is published
  s2 --> s1: the minute poll refreshes the page
  s2 --> s3: the stream reconnects
  s3 --> s0: the minute poll refreshes the page or a pulse is published
  s3 --> s2: the stream errors
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 teal
  class s0 bugPath
  class s1 teal
  class s1 bugPath
  class s2 orange
  class s2 bugPath
  class s3 pink
  class s3 breaks
  class s3 bugPath
